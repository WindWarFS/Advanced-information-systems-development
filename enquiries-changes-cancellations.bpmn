      <bpmndi:BPMNLabel><dc:Bounds x="1135.0" y="289.0" width="63.8" height="33.0"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConfirmPatient_di" bpmnElement="Task_ConfirmPatient">
        <dc:Bounds x="1300" y="230" width="100" height="80"/>
