        <dc:Bounds x="420" y="230" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_EnquiryType_di" bpmnElement="Gateway_EnquiryType" isMarkerVisible="true">
        <dc:Bounds x="665" y="245" width="50" height="50"/>
      <bpmndi:BPMNLabel><dc:Bounds x="695.0" y="289.0" width="88.6" height="19.5"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateBooking_di" bpmnElement="Task_UpdateBooking">
