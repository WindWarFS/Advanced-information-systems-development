<?xml version="1.0" encoding="utf-8"?><bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Enquiries" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Kimi Work" exporterVersion="3.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Enquiries" name="Hospital - Enquiries" processRef="Process_Enquiries"/>
    <bpmn:participant id="Participant_Patient" name="Patient"/>
    <bpmn:messageFlow id="MF_P1" name="Enquiry call" sourceRef="Participant_Patient" targetRef="StartEvent_EnquiryCall"/>
    <bpmn:messageFlow id="MF_P2" name="Outcome confirmation" sourceRef="Task_ConfirmPatient" targetRef="Participant_Patient"/>
    <bpmn:messageFlow id="MF_P3" name="Clinical advice call" sourceRef="Task_CNSContact" targetRef="Participant_Patient"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Enquiries" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_CallHandling" name="Call Handling Team">
        <bpmn:flowNodeRef>StartEvent_EnquiryCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LogEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EnquiryType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentInvolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnswerAdmin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CNS" name="Clinical Nurse Specialist Team">
        <bpmn:flowNodeRef>Task_CNSContact</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance Team">
        <bpmn:flowNodeRef>Task_ProcessRefund</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_EnquiryCall" name="Patient call / enquiry received">
      <bpmn:messageEventDefinition id="MED_StartEvent_EnquiryCall"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_LogEnquiry" name="Log and sort enquiry"/>
    <bpmn:exclusiveGateway id="Gateway_EnquiryType" name="Enquiry type?"/>
    <bpmn:task id="Task_UpdateBooking" name="Update or cancel booking"/>
    <bpmn:exclusiveGateway id="Gateway_PaymentInvolved" name="Payment involved?"/>
    <bpmn:task id="Task_ConfirmPatient" name="Confirm outcome to patient"/>
    <bpmn:endEvent id="EndEvent_Resolved" name="Enquiry resolved"/>
    <bpmn:task id="Task_AnswerAdmin" name="Answer administrative query directly"/>
    <bpmn:task id="Task_CNSContact" name="Contact patient; answer clinical question"/>
    <bpmn:task id="Task_ProcessRefund" name="Process refund"/>
    <bpmn:sequenceFlow id="Flow_E1" sourceRef="StartEvent_EnquiryCall" targetRef="Task_LogEnquiry"/>
    <bpmn:sequenceFlow id="Flow_E2" sourceRef="Task_LogEnquiry" targetRef="Gateway_EnquiryType"/>
    <bpmn:sequenceFlow id="Flow_E3" name="Simple administrative query" sourceRef="Gateway_EnquiryType" targetRef="Task_AnswerAdmin"/>
    <bpmn:sequenceFlow id="Flow_E4" sourceRef="Task_AnswerAdmin" targetRef="Task_ConfirmPatient"/>
    <bpmn:sequenceFlow id="Flow_E5" name="Clinical question" sourceRef="Gateway_EnquiryType" targetRef="Task_CNSContact"/>
    <bpmn:sequenceFlow id="Flow_E6" sourceRef="Task_CNSContact" targetRef="Task_ConfirmPatient"/>
    <bpmn:sequenceFlow id="Flow_E7" name="Change / cancel" sourceRef="Gateway_EnquiryType" targetRef="Task_UpdateBooking"/>
    <bpmn:sequenceFlow id="Flow_E8" sourceRef="Task_UpdateBooking" targetRef="Gateway_PaymentInvolved"/>
    <bpmn:sequenceFlow id="Flow_E9" name="No payment involved" sourceRef="Gateway_PaymentInvolved" targetRef="Task_ConfirmPatient"/>
    <bpmn:sequenceFlow id="Flow_E10" name="Refund required" sourceRef="Gateway_PaymentInvolved" targetRef="Task_ProcessRefund"/>
    <bpmn:sequenceFlow id="Flow_E11" name="Refund processed" sourceRef="Task_ProcessRefund" targetRef="Task_ConfirmPatient"/>
    <bpmn:sequenceFlow id="Flow_E12" sourceRef="Task_ConfirmPatient" targetRef="EndEvent_Resolved"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Enquiries_di" bpmnElement="Participant_Enquiries" isHorizontal="true">
        <dc:Bounds x="160" y="90" width="1520" height="480"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Patient_di" bpmnElement="Participant_Patient" isHorizontal="true">
        <dc:Bounds x="160" y="10" width="1520" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CallHandling_di" bpmnElement="Lane_CallHandling" isHorizontal="true">
        <dc:Bounds x="190" y="90" width="1490" height="240"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CNS_di" bpmnElement="Lane_CNS" isHorizontal="true">
