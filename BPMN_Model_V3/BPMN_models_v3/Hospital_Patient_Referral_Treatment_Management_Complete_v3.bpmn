<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_HospitalPathway" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_HospitalPathway" name="Hospital Patient Referral, Treatment and Management">
    <bpmn:participant id="Participant_Referring" name="Referring Organisation" processRef="Process_Referring" />
    <bpmn:participant id="Participant_Patient" name="Patient" processRef="Process_Patient" />
    <bpmn:participant id="Participant_Hospital" name="Hospital" processRef="Process_Hospital" />
    <bpmn:participant id="Participant_External" name="External Payment and Funding Providers" processRef="Process_External" />
    <bpmn:messageFlow id="M_T01_T02" name="Referral and Clinical Information" sourceRef="Prepare_and_Submit_Referral" targetRef="Hospital_Referral_Process_Started" />
    <bpmn:messageFlow id="M_T05_T06" name="Missing Information Request" sourceRef="Request_Missing_Information" targetRef="Missing_Information_Requested" />
    <bpmn:messageFlow id="M_T06_T07" name="Missing Information Response" sourceRef="Information_Sent" targetRef="Wait_for_Missing_Information_Response" />
    <bpmn:messageFlow id="M_T10_RefNotice" name="Referral Decision" sourceRef="Send_Referral_Decision" targetRef="Referral_Decision_Received_Referring_Organisation" />
    <bpmn:messageFlow id="M_T10_PatientNotice" name="Referral Outcome" sourceRef="Send_Referral_Decision" targetRef="Referral_Decision_Received_Patient" />
    <bpmn:messageFlow id="M_T16_T17" name="Appointment Details" sourceRef="Send_Appointment_Details" targetRef="Appointment_Details_Received" />
    <bpmn:messageFlow id="M_Change_StartHospital" name="Appointment Change Request" sourceRef="Change_Requested" targetRef="Appointment_Change_Received" />
    <bpmn:messageFlow id="M_Cancel_Hospital" name="Appointment Cancellation" sourceRef="Appointment_Cancelled_Patient" targetRef="Cancellation_Received" />
    <bpmn:messageFlow id="M_Consult_StartHospital" name="Consultation Attendance" sourceRef="Consultation_Attended" targetRef="Consultation_Completed" />
    <bpmn:messageFlow id="M_Proposal_T21" name="Treatment Proposal" sourceRef="Send_Treatment_Proposal" targetRef="Treatment_Proposal_Received" />
    <bpmn:messageFlow id="M_Consent_Catch" name="Consent Granted" sourceRef="Consent_Granted" targetRef="Consent_Decision_Received" />
    <bpmn:messageFlow id="M_Refuse_Catch" name="Consent Refused" sourceRef="Treatment_Refused" targetRef="Consent_Decision_Received" />
    <bpmn:messageFlow id="M_T25_T26" name="Payment Request" sourceRef="Send_Payment_Request" targetRef="Payment_Request_Received" />
    <bpmn:messageFlow id="M_T26_StartExternalPayment" name="Payment Information" sourceRef="Payment_Information_Sent" targetRef="Payment_Processing_Request" />
    <bpmn:messageFlow id="M_Funding_StartExternalFunding" name="Funding Approval Request" sourceRef="Send_Funding_Approval_Request" targetRef="Funding_Approval_Request" />
    <bpmn:messageFlow id="M_ExternalPayment_Catch" name="Payment Result" sourceRef="Payment_Result_Sent" targetRef="Payment_Result_Received" />
    <bpmn:messageFlow id="M_ExternalFunding_Catch" name="Funding Approval Result" sourceRef="Funding_Result_Sent" targetRef="Funding_Approval_Result_Received" />
    <bpmn:messageFlow id="M_T32_T33" name="Treatment Arrangement" sourceRef="Send_Treatment_Arrangement" targetRef="Treatment_Arrangement_Received" />
    <bpmn:messageFlow id="M_TreatmentAttendance_StartHospital" name="Treatment Attendance" sourceRef="Treatment_Attended" targetRef="Patient_Arrived_for_Treatment" />
    <bpmn:messageFlow id="M_T38_PatientLetter" name="Clinic Letter and Follow-up" sourceRef="Send_Clinic_Letter" targetRef="Clinic_Letter_Received_Patient" />
    <bpmn:messageFlow id="M_T38_RefLetter" name="Clinic Letter" sourceRef="Send_Clinic_Letter" targetRef="Clinic_Letter_Received_Referring_Organisation" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Referring" name="Referring Organisation" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Process_Referring">
      <bpmn:lane id="Lane_Referring" name="Referring Organisation">
        <bpmn:flowNodeRef>Referral_Process_Started</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Missing_Information_Requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Information_Sent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pathway_Updated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Provide_Missing_Information</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Clinic_Letter_Received_Referring_Organisation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Referral_Closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Referral_Decision_Received_Referring_Organisation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Referral_Submitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Enter_Referral_Details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prepare_and_Submit_Referral</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Referral_Process_Started" name="Referral Process Started">
      <bpmn:outgoing>S_Ref_Start_EnterDetails</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="Missing_Information_Requested" name="Missing Information Requested">
      <bpmn:extensionElements />
      <bpmn:outgoing>S_Ref_StartMissing_T06</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Start_MissingInfo" messageRef="Msg_MissingInfoRequest" />
    </bpmn:startEvent>
    <bpmn:endEvent id="Information_Sent" name="Information Sent">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="Information_Sent" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_Ref_T06_End</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_End_MissingInfoSent" messageRef="Msg_MissingInfoResponse" />
    </bpmn:endEvent>
    <bpmn:endEvent id="Pathway_Updated" name="Pathway Updated">
      <bpmn:incoming>S_Ref_Letter_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Provide_Missing_Information" name="Provide Missing Information">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Provide_Missing_Information" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_Ref_StartMissing_T06</bpmn:incoming>
      <bpmn:outgoing>S_Ref_T06_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="Clinic_Letter_Received_Referring_Organisation" name="Clinic Letter Received">
      <bpmn:extensionElements />
      <bpmn:outgoing>S_Ref_Letter_End</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Start_ClinicLetter_Ref" messageRef="Msg_ClinicLetter" />
    </bpmn:startEvent>
    <bpmn:endEvent id="Referral_Closed" name="Referral Closed">
      <bpmn:incoming>S_Ref_Notice_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Referral_Decision_Received_Referring_Organisation" name="Referral Decision Received">
      <bpmn:extensionElements />
      <bpmn:outgoing>S_Ref_Notice_End</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Start_ReferralNotice_Ref" messageRef="Msg_ReferralDecision_Referring_Organisation" />
    </bpmn:startEvent>
    <bpmn:endEvent id="Referral_Submitted" name="Referral Submitted">
      <bpmn:incoming>S_Ref_T01_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Enter_Referral_Details" name="Enter Referral Details">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Enter_Referral_Details" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_Ref_Start_EnterDetails</bpmn:incoming>
      <bpmn:outgoing>S_Ref_EnterDetails_T01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Prepare_and_Submit_Referral" name="Prepare and Submit Referral" messageRef="Msg_Referral">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="Prepare_and_Submit_Referral" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_Ref_EnterDetails_T01</bpmn:incoming>
      <bpmn:outgoing>S_Ref_T01_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="S_Ref_Start_EnterDetails" sourceRef="Referral_Process_Started" targetRef="Enter_Referral_Details" />
    <bpmn:sequenceFlow id="S_Ref_EnterDetails_T01" sourceRef="Enter_Referral_Details" targetRef="Prepare_and_Submit_Referral" />
    <bpmn:sequenceFlow id="S_Ref_StartMissing_T06" sourceRef="Missing_Information_Requested" targetRef="Provide_Missing_Information" />
    <bpmn:sequenceFlow id="S_Ref_T06_End" sourceRef="Provide_Missing_Information" targetRef="Information_Sent" />
    <bpmn:sequenceFlow id="S_Ref_Letter_End" sourceRef="Clinic_Letter_Received_Referring_Organisation" targetRef="Pathway_Updated" />
    <bpmn:sequenceFlow id="S_Ref_Notice_End" sourceRef="Referral_Decision_Received_Referring_Organisation" targetRef="Referral_Closed" />
    <bpmn:sequenceFlow id="S_Ref_T01_End" sourceRef="Prepare_and_Submit_Referral" targetRef="Referral_Submitted" />
  </bpmn:process>
  <bpmn:process id="Process_Patient" name="Patient" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Process_Patient">
      <bpmn:lane id="Lane_Patient" name="Patient">
        <bpmn:flowNodeRef>Appointment_Details_Received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Change_Requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Payment_Request_Received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Payment_Information_Sent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review_Appointment_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Attend_Initial_Consultation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Provide_Payment_or_Funding_Information</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Appointment_Confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Patient_Consent_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Appointment_Cancelled_Patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Consultation_Attended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Submit_Consent_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Consent_Granted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Treatment_Refused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Treatment_Attended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Treatment_Arrangement_Received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Attend_Treatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Clinic_Letter_Received_Patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Follow_up_Arranged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Referral_Pathway_Closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Referral_Decision_Received_Patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Treatment_Proposal_Received</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Appointment_Details_Received" name="Appointment Details Received">
      <bpmn:extensionElements />
      <bpmn:outgoing>S_Patient_Start_T17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Start_PatientAppointment" messageRef="Msg_AppointmentDetails" />
    </bpmn:startEvent>
    <bpmn:endEvent id="Change_Requested" name="Change Requested">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="Change_Requested" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_G04_EndChange</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_End_ChangeRequested" messageRef="Msg_AppointmentChange" />
    </bpmn:endEvent>
    <bpmn:startEvent id="Payment_Request_Received" name="Payment Request Received">
      <bpmn:extensionElements />
      <bpmn:outgoing>S_Patient_StartPayment_T26</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Start_PaymentRequest" messageRef="Msg_PaymentRequest" />
    </bpmn:startEvent>
    <bpmn:endEvent id="Payment_Information_Sent" name="Payment Information Sent">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="Payment_Information_Sent" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_T26_EndPayment</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_End_PaymentInfo" messageRef="Msg_PaymentInformation" />
    </bpmn:endEvent>
    <bpmn:userTask id="Review_Appointment_Request" name="Review Appointment Request">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Review_Appointment_Request" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_Patient_Start_T17</bpmn:incoming>
      <bpmn:outgoing>S_T17_G04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Attend_Initial_Consultation" name="Attend Initial Consultation">
      <bpmn:incoming>S_G04_T18</bpmn:incoming>
      <bpmn:outgoing>S_T18_EndConsult</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Provide_Payment_or_Funding_Information" name="Provide Payment or Funding Information">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Provide_Payment_or_Funding_Information" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_Patient_StartPayment_T26</bpmn:incoming>
      <bpmn:outgoing>S_T26_EndPayment</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Appointment_Confirmed" name="Appointment Confirmed?" default="S_G04_EndCancel">
      <bpmn:incoming>S_T17_G04</bpmn:incoming>
      <bpmn:outgoing>S_G04_T18</bpmn:outgoing>
      <bpmn:outgoing>S_G04_EndChange</bpmn:outgoing>
      <bpmn:outgoing>S_G04_EndCancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Patient_Consent_Decision" name="Patient Consent Decision?" default="S_G06_EndRefuse">
      <bpmn:incoming>S_T21_G06</bpmn:incoming>
      <bpmn:outgoing>S_G06_EndConsent</bpmn:outgoing>
      <bpmn:outgoing>S_G06_EndRefuse</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Appointment_Cancelled_Patient" name="Appointment Cancelled">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="Appointment_Cancelled_Patient" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_G04_EndCancel</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_End_AppointmentCancelled" messageRef="Msg_AppointmentCancel" />
    </bpmn:endEvent>
    <bpmn:endEvent id="Consultation_Attended" name="Consultation Attended">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="Consultation_Attended" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_T18_EndConsult</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_End_ConsultationAttended" messageRef="Msg_ConsultationAttended" />
    </bpmn:endEvent>
    <bpmn:userTask id="Submit_Consent_Decision" name="Submit Consent Decision">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Submit_Consent_Decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_Patient_StartProposal_T21</bpmn:incoming>
      <bpmn:outgoing>S_T21_G06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Consent_Granted" name="Consent Granted">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="Consent_Granted" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_G06_EndConsent</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_End_ConsentGranted" messageRef="Msg_ConsentDecision" />
    </bpmn:endEvent>
    <bpmn:endEvent id="Treatment_Refused" name="Treatment Refused">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="Treatment_Refused" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_G06_EndRefuse</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_End_ConsentRefused" messageRef="Msg_ConsentDecision" />
    </bpmn:endEvent>
    <bpmn:endEvent id="Treatment_Attended" name="Treatment Attended">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="Treatment_Attended" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_T33_EndAttended</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_End_TreatmentAttended" messageRef="Msg_TreatmentAttendance" />
    </bpmn:endEvent>
    <bpmn:startEvent id="Treatment_Arrangement_Received" name="Treatment Arrangement Received">
      <bpmn:extensionElements />
      <bpmn:outgoing>S_Patient_StartTreatment_T33</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Start_TreatmentArrangement" messageRef="Msg_TreatmentArrangement" />
    </bpmn:startEvent>
    <bpmn:manualTask id="Attend_Treatment" name="Attend Treatment">
      <bpmn:incoming>S_Patient_StartTreatment_T33</bpmn:incoming>
      <bpmn:outgoing>S_T33_EndAttended</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:startEvent id="Clinic_Letter_Received_Patient" name="Clinic Letter Received">
      <bpmn:extensionElements />
      <bpmn:outgoing>S_Patient_Letter_End</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Start_ClinicLetter_Patient" messageRef="Msg_ClinicLetter_Patient" />
    </bpmn:startEvent>
    <bpmn:endEvent id="Follow_up_Arranged" name="Follow-up Arranged">
      <bpmn:incoming>S_Patient_Letter_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Referral_Pathway_Closed" name="Referral Pathway Closed">
      <bpmn:incoming>S_Patient_ReferralNotice_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Referral_Decision_Received_Patient" name="Referral Decision Received">
      <bpmn:extensionElements />
      <bpmn:outgoing>S_Patient_ReferralNotice_End</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Start_ReferralNotice_Patient" messageRef="Msg_ReferralDecision_Patient" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Treatment_Proposal_Received" name="Treatment Proposal Received">
      <bpmn:extensionElements />
      <bpmn:outgoing>S_Patient_StartProposal_T21</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Start_TreatmentProposal" messageRef="Msg_TreatmentProposal" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="S_Patient_Start_T17" sourceRef="Appointment_Details_Received" targetRef="Review_Appointment_Request" />
    <bpmn:sequenceFlow id="S_G04_EndChange" name="Request Change" sourceRef="Appointment_Confirmed" targetRef="Change_Requested">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentDecision = "change"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_Patient_StartPayment_T26" sourceRef="Payment_Request_Received" targetRef="Provide_Payment_or_Funding_Information" />
    <bpmn:sequenceFlow id="S_T26_EndPayment" sourceRef="Provide_Payment_or_Funding_Information" targetRef="Payment_Information_Sent" />
    <bpmn:sequenceFlow id="S_T17_G04" sourceRef="Review_Appointment_Request" targetRef="Appointment_Confirmed" />
    <bpmn:sequenceFlow id="S_G04_T18" name="Confirm" sourceRef="Appointment_Confirmed" targetRef="Attend_Initial_Consultation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentDecision = "confirm"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_T18_EndConsult" sourceRef="Attend_Initial_Consultation" targetRef="Consultation_Attended" />
    <bpmn:sequenceFlow id="S_G04_EndCancel" name="Cancel" sourceRef="Appointment_Confirmed" targetRef="Appointment_Cancelled_Patient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentDecision = "cancel"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_T21_G06" sourceRef="Submit_Consent_Decision" targetRef="Patient_Consent_Decision" />
    <bpmn:sequenceFlow id="S_G06_EndConsent" name="Consent" sourceRef="Patient_Consent_Decision" targetRef="Consent_Granted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentDecision = "consent"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_G06_EndRefuse" name="Refuse" sourceRef="Patient_Consent_Decision" targetRef="Treatment_Refused">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentDecision = "refuse"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_Patient_StartProposal_T21" sourceRef="Treatment_Proposal_Received" targetRef="Submit_Consent_Decision" />
    <bpmn:sequenceFlow id="S_T33_EndAttended" sourceRef="Attend_Treatment" targetRef="Treatment_Attended" />
    <bpmn:sequenceFlow id="S_Patient_StartTreatment_T33" sourceRef="Treatment_Arrangement_Received" targetRef="Attend_Treatment" />
    <bpmn:sequenceFlow id="S_Patient_Letter_End" sourceRef="Clinic_Letter_Received_Patient" targetRef="Follow_up_Arranged" />
    <bpmn:sequenceFlow id="S_Patient_ReferralNotice_End" sourceRef="Referral_Decision_Received_Patient" targetRef="Referral_Pathway_Closed" />
  </bpmn:process>
  <bpmn:process id="Process_Hospital" name="Hospital" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Process_Hospital">
      <bpmn:lane id="Lane_Admin" name="Administrative and Appointment Team">
        <bpmn:flowNodeRef>Pathway_Completed_Successfully</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Check_Referral_Documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prepare_Appointment_Search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Book_Initial_Appointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_Letter_and_Arrange_Follow_up</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_Clinic_Letter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Referral_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Recheck_Referral_Documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Appointment_Change_Received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Appointment_Cancelled_Hospital</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancellation_Received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_Appointment_Details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Arrange_Treatment_Appointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Check_and_Reserve_Treatment_Slot</bpmn:flowNodeRef>
