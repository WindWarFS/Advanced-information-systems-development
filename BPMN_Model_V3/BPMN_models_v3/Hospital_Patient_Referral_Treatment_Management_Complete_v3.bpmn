      <bpmn:outgoing>S_T08_G02</bpmn:outgoing>
      <bpmn:property id="Property_0q9g895" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1antk1t">
        <bpmn:sourceRef>DataRef_Referral</bpmn:sourceRef>
        <bpmn:targetRef>Property_0q9g895</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:endEvent id="Appointment_Details_Sent" name="Appointment Details Sent">
      <bpmn:incoming>S_T16_EndAppointmentDetails</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Hospital_Referral_Process_Started" name="Referral Received">
