      <bpmn:messageEventDefinition id="MessageEventDefinition_Start_Referral" messageRef="Msg_Referral" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="S_StartTreatment_T34" sourceRef="Patient_Arrived_for_Treatment" targetRef="Perform_Treatment" />
    <bpmn:sequenceFlow id="S_T38_EndSuccess" sourceRef="Send_Clinic_Letter" targetRef="Pathway_Completed_Successfully" />
    <bpmn:sequenceFlow id="S_Hospital_Start_T03" sourceRef="Hospital_Referral_Process_Started" targetRef="Create_Referral_Record" />
    <bpmn:sequenceFlow id="S_T03_T04" sourceRef="Create_Referral_Record" targetRef="Check_Referral_Documents" />
    <bpmn:sequenceFlow id="S_T04_G01" sourceRef="Check_Referral_Documents" targetRef="Referral_Complete" />
    <bpmn:sequenceFlow id="S_StartAppointmentChange_T11" sourceRef="Appointment_Change_Received" targetRef="Prepare_Appointment_Search" />
    <bpmn:sequenceFlow id="S_ClinicalDecision_T11" name="Accepted Referral" sourceRef="Clinical_Decision_Record_Outcome" targetRef="Prepare_Appointment_Search">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalDecision = "accept"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_T11_T12" sourceRef="Prepare_Appointment_Search" targetRef="Check_Appointment_Availability" />
    <bpmn:sequenceFlow id="S_G03_T15" name="Available" sourceRef="Suitable_Appointment_Available" targetRef="Book_Initial_Appointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= suitableAppointmentAvailable = "AVAILABLE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_T15_T16" sourceRef="Book_Initial_Appointment" targetRef="Send_Appointment_Details" />
    <bpmn:sequenceFlow id="S_StartConsultation_T19" sourceRef="Consultation_Completed" targetRef="Assess_Patient_and_Explain_Options" />
    <bpmn:sequenceFlow id="S_T20_T19" sourceRef="Arrange_Further_Assessment" targetRef="Assess_Patient_and_Explain_Options" />
    <bpmn:sequenceFlow id="S_T19_G05" sourceRef="Assess_Patient_and_Explain_Options" targetRef="Consultation_Outcome" />
    <bpmn:sequenceFlow id="S_T34_T35" sourceRef="Perform_Treatment" targetRef="Store_Treatment_Results" />
    <bpmn:sequenceFlow id="S_T35_T36" sourceRef="Store_Treatment_Results" targetRef="Review_Treatment_Results" />
    <bpmn:sequenceFlow id="S_T36_G09" sourceRef="Review_Treatment_Results" targetRef="Treatment_Review_Outcome" />
    <bpmn:sequenceFlow id="S_G09_T37" name="End Treatment" sourceRef="Treatment_Review_Outcome" targetRef="Prepare_and_Approve_Clinic_Letter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= treatmentReview = "end"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_T37_T38" sourceRef="Prepare_and_Approve_Clinic_Letter" targetRef="Send_Letter_and_Arrange_Follow_up" />
    <bpmn:sequenceFlow id="S_T38_SendClinicLetter" sourceRef="Send_Letter_and_Arrange_Follow_up" targetRef="Send_Clinic_Letter" />
    <bpmn:sequenceFlow id="S_T08_G02" sourceRef="Review_Referral" targetRef="Clinical_Referral_Decision" />
    <bpmn:sequenceFlow id="S_G02_T05" name="More Information" sourceRef="Clinical_Referral_Decision" targetRef="Request_Missing_Information">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalDecision = "more_information"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_G02_T09_Accept" name="Accept" sourceRef="Clinical_Referral_Decision" targetRef="Record_Clinical_Decision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalDecision = "accept"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_G02_T09_Reject" name="Reject" sourceRef="Clinical_Referral_Decision" targetRef="Record_Clinical_Decision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalDecision = "reject"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_G02_T09_Redirect" name="Redirect" sourceRef="Clinical_Referral_Decision" targetRef="Record_Clinical_Decision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalDecision = "redirect"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_G09_T36" name="Pause" sourceRef="Treatment_Review_Outcome" targetRef="Review_Treatment_Results">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= treatmentReview = "pause"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_G09_T22" name="Modify" sourceRef="Treatment_Review_Outcome" targetRef="Review_Consent_and_Authorise_Treatment_Request">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= treatmentReview = "modify"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_G09_T30" name="Continue" sourceRef="Treatment_Review_Outcome" targetRef="Arrange_Treatment_Appointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= treatmentReview = "continue"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_T07_G01" sourceRef="Recheck_Referral_Documents" targetRef="Referral_Complete" />
    <bpmn:sequenceFlow id="S_G01_T05" name="Incomplete" sourceRef="Referral_Complete" targetRef="Request_Missing_Information">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralComplete = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_G01_T08" name="Complete" sourceRef="Referral_Complete" targetRef="Review_Referral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralComplete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_Record_Clinical_Decision_Clinical_Decision_Record_Outcome" sourceRef="Record_Clinical_Decision" targetRef="Clinical_Decision_Record_Outcome" />
    <bpmn:sequenceFlow id="S_WaitMissingResponse_T07" sourceRef="Wait_for_Missing_Information_Response" targetRef="Recheck_Referral_Documents" />
    <bpmn:sequenceFlow id="S_BoundaryMissing_EndIncomplete" sourceRef="Recheck_Referral_Documents" targetRef="Incomplete_Referral_Closed_Manual_Handling" />
    <bpmn:sequenceFlow id="S_T12_G03" sourceRef="Check_Appointment_Availability" targetRef="Suitable_Appointment_Available" />
    <bpmn:sequenceFlow id="S_StartCancel_End" sourceRef="Cancellation_Received" targetRef="Appointment_Cancelled_Hospital" />
    <bpmn:sequenceFlow id="S_T16_EndAppointmentDetails" sourceRef="Send_Appointment_Details" targetRef="Appointment_Details_Sent" />
    <bpmn:sequenceFlow id="S_G05_T20" name="Further Assessment" sourceRef="Consultation_Outcome" targetRef="Arrange_Further_Assessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consultationOutcome = "assessment"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_G05_ThrowProposal" name="Treatment Proposed" sourceRef="Consultation_Outcome" targetRef="Send_Treatment_Proposal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consultationOutcome = "treatment"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_ThrowProposal_G10" sourceRef="Send_Treatment_Proposal" targetRef="Start_Treatment_Authorisation_and_Financial_Preparation" />
    <bpmn:sequenceFlow id="S_G10_CatchConsent" name="Treatment Authorisation" sourceRef="Start_Treatment_Authorisation_and_Financial_Preparation" targetRef="Consent_Decision_Received" />
    <bpmn:sequenceFlow id="S_G10_T24" name="Financial Preparation" sourceRef="Start_Treatment_Authorisation_and_Financial_Preparation" targetRef="Determine_Financial_Requirements" />
    <bpmn:sequenceFlow id="S_CatchConsent_T22" sourceRef="Consent_Decision_Received" targetRef="Review_Consent_and_Authorise_Treatment_Request" />
    <bpmn:sequenceFlow id="S_Review_Consent_and_Authorise_Treatment_Request_Treatment_Authorisation_Outcome" sourceRef="Review_Consent_and_Authorise_Treatment_Request" targetRef="Treatment_Authorisation_Outcome" />
    <bpmn:sequenceFlow id="S_G07_T25" name="Patient Payment" sourceRef="Which_Financial_Actions_Are_Required" targetRef="Issue_Payment_Request">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requiresPatientPayment = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_T25_SendPayment" sourceRef="Issue_Payment_Request" targetRef="Send_Payment_Request" />
    <bpmn:sequenceFlow id="S_T25_CatchPayment" sourceRef="Send_Payment_Request" targetRef="Payment_Result_Received" />
    <bpmn:sequenceFlow id="S_T24_G07" sourceRef="Determine_Financial_Requirements" targetRef="Which_Financial_Actions_Are_Required" />
    <bpmn:sequenceFlow id="S_G07_ThrowFunding" name="Funding Approval" sourceRef="Which_Financial_Actions_Are_Required" targetRef="Send_Funding_Approval_Request">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requiresFundingApproval = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_G07_G08" name="No Additional Action" sourceRef="Which_Financial_Actions_Are_Required" targetRef="Are_All_Applicable_Financial_Conditions_Satisfied" />
    <bpmn:sequenceFlow id="S_CatchPayment_G08" sourceRef="Payment_Result_Received" targetRef="Are_All_Applicable_Financial_Conditions_Satisfied" />
    <bpmn:sequenceFlow id="S_G08_T29" name="Cleared" sourceRef="Are_All_Applicable_Financial_Conditions_Satisfied" targetRef="Record_Financial_Clearance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= financialStatus = "cleared"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_T29_T30" sourceRef="Record_Financial_Clearance" targetRef="Arrange_Treatment_Appointment" />
    <bpmn:sequenceFlow id="S_G08_EndFailed" name="Failed" sourceRef="Are_All_Applicable_Financial_Conditions_Satisfied" targetRef="Financial_Clearance_Failed_Manual_Handling" />
    <bpmn:sequenceFlow id="S_ThrowFunding_CatchFunding" sourceRef="Send_Funding_Approval_Request" targetRef="Funding_Approval_Result_Received" />
    <bpmn:sequenceFlow id="S_CatchFunding_G08" sourceRef="Funding_Approval_Result_Received" targetRef="Are_All_Applicable_Financial_Conditions_Satisfied" />
    <bpmn:sequenceFlow id="S_T23_G08" sourceRef="Store_Treatment_Request" targetRef="Are_All_Applicable_Financial_Conditions_Satisfied" />
    <bpmn:sequenceFlow id="S_T30_T31" sourceRef="Arrange_Treatment_Appointment" targetRef="Check_and_Reserve_Treatment_Slot" />
    <bpmn:sequenceFlow id="S_T31_T32" sourceRef="Check_and_Reserve_Treatment_Slot" targetRef="Confirm_and_Notify_Treatment_Arrangement" />
    <bpmn:sequenceFlow id="S_T32_SendArrangement" sourceRef="Confirm_and_Notify_Treatment_Arrangement" targetRef="Send_Treatment_Arrangement" />
    <bpmn:sequenceFlow id="S_T32_EndArrangement" sourceRef="Send_Treatment_Arrangement" targetRef="Treatment_Arrangement_Sent" />
    <bpmn:sequenceFlow id="S_ClinicalDecision_T10" name="Rejected or Redirected" sourceRef="Clinical_Decision_Record_Outcome" targetRef="Notify_Referral_Parties">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalDecision = "reject" or clinicalDecision = "redirect"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_TreatmentAuthorisation_T23" name="Consent Granted" sourceRef="Treatment_Authorisation_Outcome" targetRef="Store_Treatment_Request">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= treatmentAuthorised = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_TreatmentAuthorisation_Refused" name="Consent Refused" sourceRef="Treatment_Authorisation_Outcome" targetRef="Patient_Refused_Treatment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= treatmentAuthorised = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_T10_SendDecision" sourceRef="Notify_Referral_Parties" targetRef="Send_Referral_Decision" />
    <bpmn:sequenceFlow id="S_T10_EndRejected" sourceRef="Send_Referral_Decision" targetRef="Referral_Rejected_or_Redirected" />
    <bpmn:sequenceFlow id="S_G03_T11" name="Not Available" sourceRef="Suitable_Appointment_Available" targetRef="Prepare_Appointment_Search">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= suitableAppointmentAvailable = "NOT_AVAILABLE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_T05_WaitMissingResponse" sourceRef="Request_Missing_Information" targetRef="Wait_for_Missing_Information_Response" />
    <bpmn:association id="A_T03_Store" associationDirection="One" sourceRef="Create_Referral_Record" targetRef="DataStoreRef_PatientPathway" />
    <bpmn:association id="A_T35_Store" associationDirection="One" sourceRef="Store_Treatment_Results" targetRef="DataStoreRef_PatientPathway" />
    <bpmn:association id="A_T23_Store" associationDirection="One" sourceRef="Store_Treatment_Request" targetRef="DataStoreRef_PatientPathway" />
    <bpmn:association id="A_T29_Financial" associationDirection="One" sourceRef="Record_Financial_Clearance" targetRef="DataRef_Financial" />
  </bpmn:process>
  <bpmn:process id="Process_External" name="External Payment and Funding Providers" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Process_External">
      <bpmn:lane id="Lane_External" name="External Payment and Funding Providers">
        <bpmn:flowNodeRef>Process_Payment_Transaction_or_Funding_Approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Funding_Approval_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Payment_Processing_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Payment_or_Funding_Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Funding_Result_Sent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Payment_Result_Sent</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="Process_Payment_Transaction_or_Funding_Approval" name="Process Payment Transaction or Funding Approval">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="Process_Payment_Transaction_or_Funding_Approval" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_StartExternalPayment_T27</bpmn:incoming>
      <bpmn:incoming>S_StartExternalFunding_T27</bpmn:incoming>
      <bpmn:outgoing>S_Process_Payment_Transaction_or_Funding_Approval_Payment_or_Funding_Result</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="Funding_Approval_Request" name="Funding Approval Request">
      <bpmn:extensionElements />
      <bpmn:outgoing>S_StartExternalFunding_T27</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Start_ExternalFunding" messageRef="Msg_FundingRequest" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Payment_Processing_Request" name="Payment Processing Request">
      <bpmn:extensionElements />
      <bpmn:outgoing>S_StartExternalPayment_T27</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Start_ExternalPayment" messageRef="Msg_PaymentInformation" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Payment_or_Funding_Result" name="Payment or Funding Result?" default="S_PaymentResult_Funding">
      <bpmn:incoming>S_Process_Payment_Transaction_or_Funding_Approval_Payment_or_Funding_Result</bpmn:incoming>
      <bpmn:outgoing>S_PaymentResult_Payment</bpmn:outgoing>
      <bpmn:outgoing>S_PaymentResult_Funding</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Funding_Result_Sent" name="Funding Result Sent">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="Funding_Result_Sent" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_PaymentResult_Funding</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_End_ExternalFundingResult" messageRef="Msg_FundingResult" />
    </bpmn:endEvent>
    <bpmn:endEvent id="Payment_Result_Sent" name="Payment Result Sent">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="Payment_Result_Sent" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_PaymentResult_Payment</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_End_ExternalPaymentResult" messageRef="Msg_PaymentResult" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="S_StartExternalPayment_T27" sourceRef="Payment_Processing_Request" targetRef="Process_Payment_Transaction_or_Funding_Approval" />
    <bpmn:sequenceFlow id="S_StartExternalFunding_T27" sourceRef="Funding_Approval_Request" targetRef="Process_Payment_Transaction_or_Funding_Approval" />
    <bpmn:sequenceFlow id="S_Process_Payment_Transaction_or_Funding_Approval_Payment_or_Funding_Result" sourceRef="Process_Payment_Transaction_or_Funding_Approval" targetRef="Payment_or_Funding_Result" />
    <bpmn:sequenceFlow id="S_PaymentResult_Payment" name="Payment Result" sourceRef="Payment_or_Funding_Result" targetRef="Payment_Result_Sent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requestType = "payment"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S_PaymentResult_Funding" name="Funding Result" sourceRef="Payment_or_Funding_Result" targetRef="Funding_Result_Sent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requestType = "funding"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:message id="Msg_Referral" name="Referral">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=correlationKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_MissingInfoRequest" name="Missing Information Request">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=correlationKey" />
