<?xml version="1.0" encoding="utf-8"?><bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ClinicLetter" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Kimi Work" exporterVersion="3.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Letter" name="Hospital - Clinic Letter Process" processRef="Process_ClinicLetter"/>
    <bpmn:participant id="Participant_Correspondence3" name="Correspondence Service / GP"/>
    <bpmn:messageFlow id="MF_C1" name="Letter dispatched; copy sent to GP" sourceRef="Task_SendLetter" targetRef="Participant_Correspondence3"/>
    <bpmn:messageFlow id="MF_C2" name="Urgent dispatch" sourceRef="Task_SendUrgently" targetRef="Participant_Correspondence3"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_ClinicLetter" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Consultants" name="Consultants">
        <bpmn:flowNodeRef>StartEvent_ConsultationDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DictateLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretaries" name="Medical Secretaries">
        <bpmn:flowNodeRef>Task_PrepareLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LetterSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendUrgently</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BookFollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FollowUpBooked</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordinators" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>Task_EscalateOverdue</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ConsultationDone" name="Consultation completed"/>
    <bpmn:task id="Task_DictateLetter" name="Dictate clinic letter"/>
    <bpmn:task id="Task_ApproveLetter" name="Review and approve clinic letter"/>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Letter approved?"/>
    <bpmn:task id="Task_PrepareLetter" name="Prepare clinic letter"/>
    <bpmn:task id="Task_SendLetter" name="Send clinic letter"/>
    <bpmn:boundaryEvent id="Boundary_Timer7Days" name="7 days without dispatch" attachedToRef="Task_SendLetter" cancelActivity="false">
      <bpmn:timerEventDefinition id="TED_Boundary_Timer7Days">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_FollowUp" name="Follow-up needed?"/>
    <bpmn:endEvent id="EndEvent_LetterSent" name="Letter sent"/>
    <bpmn:task id="Task_SendUrgently" name="Send letter urgently"/>
    <bpmn:task id="Task_BookFollowUp" name="Book follow-up appointment"/>
    <bpmn:endEvent id="EndEvent_FollowUpBooked" name="Follow-up booked"/>
    <bpmn:task id="Task_EscalateOverdue" name="Flag overdue letter and escalate"/>
    <bpmn:sequenceFlow id="Flow_L1" sourceRef="StartEvent_ConsultationDone" targetRef="Task_DictateLetter"/>
    <bpmn:sequenceFlow id="Flow_L2" sourceRef="Task_DictateLetter" targetRef="Task_PrepareLetter"/>
    <bpmn:sequenceFlow id="Flow_L3" sourceRef="Task_PrepareLetter" targetRef="Task_ApproveLetter"/>
    <bpmn:sequenceFlow id="Flow_L4" sourceRef="Task_ApproveLetter" targetRef="Gateway_Approved"/>
    <bpmn:sequenceFlow id="Flow_L5" name="Approved" sourceRef="Gateway_Approved" targetRef="Task_SendLetter"/>
    <bpmn:sequenceFlow id="Flow_L6" name="Changes needed" sourceRef="Gateway_Approved" targetRef="Task_PrepareLetter"/>
    <bpmn:sequenceFlow id="Flow_L7" sourceRef="Task_SendLetter" targetRef="Gateway_FollowUp"/>
    <bpmn:sequenceFlow id="Flow_L8" name="No follow-up needed" sourceRef="Gateway_FollowUp" targetRef="EndEvent_LetterSent"/>
    <bpmn:sequenceFlow id="Flow_L9" name="Follow-up required" sourceRef="Gateway_FollowUp" targetRef="Task_BookFollowUp"/>
    <bpmn:sequenceFlow id="Flow_L10" sourceRef="Task_BookFollowUp" targetRef="EndEvent_FollowUpBooked"/>
    <bpmn:sequenceFlow id="Flow_L11" sourceRef="Boundary_Timer7Days" targetRef="Task_EscalateOverdue"/>
    <bpmn:sequenceFlow id="Flow_L12" sourceRef="Task_EscalateOverdue" targetRef="Task_SendUrgently"/>
    <bpmn:sequenceFlow id="Flow_L13" name="Letter dispatched" sourceRef="Task_SendUrgently" targetRef="Gateway_FollowUp"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Letter_di" bpmnElement="Participant_Letter" isHorizontal="true">
        <dc:Bounds x="160" y="90" width="1720" height="500"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Correspondence3_di" bpmnElement="Participant_Correspondence3" isHorizontal="true">
        <dc:Bounds x="160" y="650" width="1720" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Consultants_di" bpmnElement="Lane_Consultants" isHorizontal="true">
        <dc:Bounds x="190" y="90" width="1690" height="140"/>
