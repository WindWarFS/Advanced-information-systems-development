      <bpmndi:BPMNShape id="Lane_Secretaries_di" bpmnElement="Lane_Secretaries" isHorizontal="true">
        <dc:Bounds x="190" y="230" width="1690" height="240"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Coordinators_di" bpmnElement="Lane_Coordinators" isHorizontal="true">
        <dc:Bounds x="190" y="470" width="1690" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_ConsultationDone_di" bpmnElement="StartEvent_ConsultationDone">
        <dc:Bounds x="232" y="132" width="36" height="36"/>
      <bpmndi:BPMNLabel><dc:Bounds x="208.8" y="171.0" width="82.4" height="33.0"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DictateLetter_di" bpmnElement="Task_DictateLetter">
        <dc:Bounds x="420" y="110" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApproveLetter_di" bpmnElement="Task_ApproveLetter">
        <dc:Bounds x="860" y="110" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Approved_di" bpmnElement="Gateway_Approved" isMarkerVisible="true">
        <dc:Bounds x="1105" y="125" width="50" height="50"/>
      <bpmndi:BPMNLabel><dc:Bounds x="1135.0" y="169.0" width="63.8" height="33.0"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareLetter_di" bpmnElement="Task_PrepareLetter">
