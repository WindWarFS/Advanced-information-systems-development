      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_Timer7Days_di" bpmnElement="Boundary_Timer7Days">
        <dc:Bounds x="1332" y="292" width="36" height="36"/>
      <bpmndi:BPMNLabel><dc:Bounds x="1286.6" y="315.0" width="94.8" height="33.0"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_FollowUp_di" bpmnElement="Gateway_FollowUp" isMarkerVisible="true">
        <dc:Bounds x="1545" y="245" width="50" height="50"/>
      <bpmndi:BPMNLabel><dc:Bounds x="1538.1" y="298.0" width="63.8" height="33.0"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LetterSent_di" bpmnElement="EndEvent_LetterSent">
        <dc:Bounds x="1772" y="252" width="36" height="36"/>
      <bpmndi:BPMNLabel><dc:Bounds x="1751.9" y="291.0" width="76.2" height="19.5"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendUrgently_di" bpmnElement="Task_SendUrgently">
        <dc:Bounds x="1300" y="350" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BookFollowUp_di" bpmnElement="Task_BookFollowUp">
        <dc:Bounds x="1520" y="350" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_FollowUpBooked_di" bpmnElement="EndEvent_FollowUpBooked">
        <dc:Bounds x="1772" y="372" width="36" height="36"/>
      <bpmndi:BPMNLabel><dc:Bounds x="1758.1" y="411.0" width="63.8" height="33.0"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EscalateOverdue_di" bpmnElement="Task_EscalateOverdue">
        <dc:Bounds x="1300" y="470" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_L1_di" bpmnElement="Flow_L1">
        <di:waypoint x="268" y="150"/>
        <di:waypoint x="420" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L2_di" bpmnElement="Flow_L2">
        <di:waypoint x="470" y="190"/>
        <di:waypoint x="470" y="270"/>
        <di:waypoint x="640" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_L3_di" bpmnElement="Flow_L3">
        <di:waypoint x="690" y="230"/>
