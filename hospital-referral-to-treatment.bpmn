<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ReferralTreatment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Hospital" name="Hospital - Patient Referral and Treatment" processRef="Process_ReferralTreatment" />
    <bpmn:participant id="Participant_PatientGP" name="Patient / GP" />
    <bpmn:participant id="Participant_Scheduling" name="Scheduling Service" />
    <bpmn:participant id="Participant_Payment" name="Payment Provider" />
    <bpmn:participant id="Participant_Correspondence" name="Correspondence Service" />
    <bpmn:messageFlow id="MF_01" name="Referral letter" sourceRef="Participant_PatientGP" targetRef="StartEvent_ReferralReceived" />
    <bpmn:messageFlow id="MF_02" name="Request for missing information" sourceRef="Task_RequestMissingInfo" targetRef="Participant_PatientGP" />
    <bpmn:messageFlow id="MF_03" name="Missing information resent" sourceRef="Participant_PatientGP" targetRef="Task_CheckReferral" />
    <bpmn:messageFlow id="MF_04" name="Slot request" sourceRef="Task_RequestSlot" targetRef="Participant_Scheduling" />
    <bpmn:messageFlow id="MF_06" name="Appointment letter (phone call if urgent)" sourceRef="Task_BookAppointment" targetRef="Participant_PatientGP" />
    <bpmn:messageFlow id="MF_07" name="Treatment confirmation" sourceRef="Task_BookTreatment" targetRef="Participant_PatientGP" />
    <bpmn:messageFlow id="MF_08" name="Payment request" sourceRef="Task_CheckFunding" targetRef="Participant_Payment" />
    <bpmn:messageFlow id="MF_10" name="Payment issue contact" sourceRef="Task_ContactPatientRetry" targetRef="Participant_PatientGP" />
    <bpmn:messageFlow id="MF_11" name="Clinic letter for dispatch" sourceRef="Task_SendLetter" targetRef="Participant_Correspondence" />
    <bpmn:messageFlow id="MF_12" name="Copy of clinic letter to GP" sourceRef="Task_SendLetter" targetRef="Participant_PatientGP" />
    <bpmn:messageFlow id="MF_13" name="Rejection notification" sourceRef="Task_NotifyRejection" targetRef="Participant_PatientGP" />
    <bpmn:messageFlow id="MF_14" name="Redirection notification" sourceRef="Task_NotifyRedirect" targetRef="Participant_PatientGP" />
    <bpmn:messageFlow id="MF_15" name="Funding refusal notification" sourceRef="Task_InformFundingRefused" targetRef="Participant_PatientGP" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ReferralTreatment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Finance" name="Finance">
        <bpmn:flowNodeRef>Task_CheckFunding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Funding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformFundingRefused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FundingRefused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactPatientRetry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Treatment" name="Treatment Bookings">
        <bpmn:flowNodeRef>Task_BookTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddToWaitingList</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Outpatient" name="Outpatient Bookings">
        <bpmn:flowNodeRef>Task_RequestSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SlotAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BookAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkPending</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Consultants" name="Consultants">
        <bpmn:flowNodeRef>Task_ReviewReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClinicalDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductConsultation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Consent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateTreatmentRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DictateLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestMoreInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordDNA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordDecline</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretaries" name="Medical Secretaries">
        <bpmn:flowNodeRef>StartEvent_ReferralReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Completeness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestMissingInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRedirect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Redirected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscalateOverdue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Escalated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Timer7Days</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ReferralReceived" name="Referral received from GP">
      <bpmn:messageEventDefinition id="MED_StartEvent_ReferralReceived" />
    </bpmn:startEvent>
    <bpmn:task id="Task_CheckReferral" name="Check referral documents complete" />
    <bpmn:exclusiveGateway id="Gateway_Completeness" name="Documents complete?" />
    <bpmn:task id="Task_RegisterReferral" name="Register referral and pass to Consultant" />
    <bpmn:task id="Task_PrepareLetter" name="Prepare clinic letter" />
    <bpmn:task id="Task_SendLetter" name="Send letter via correspondence service" />
    <bpmn:endEvent id="EndEvent_Complete" name="Pathway complete" />
    <bpmn:task id="Task_RequestMissingInfo" name="Request missing information from GP" />
    <bpmn:task id="Task_NotifyRejection" name="Notify GP and patient of rejection" />
    <bpmn:endEvent id="EndEvent_Rejected" name="Referral rejected" />
    <bpmn:task id="Task_NotifyRedirect" name="Notify GP of redirection to correct service" />
    <bpmn:endEvent id="EndEvent_Redirected" name="Referral redirected" />
    <bpmn:task id="Task_EscalateOverdue" name="Escalate overdue letter (Patient Pathway Coordinator)" />
    <bpmn:endEvent id="EndEvent_Escalated" name="Escalation logged" />
    <bpmn:task id="Task_ReviewReferral" name="Review referral clinically" />
    <bpmn:exclusiveGateway id="Gateway_ClinicalDecision" name="Clinical decision?" />
    <bpmn:task id="Task_ConductConsultation" name="Conduct consultation and propose treatment" />
    <bpmn:exclusiveGateway id="Gateway_Consent" name="Patient decision?" />
    <bpmn:task id="Task_CreateTreatmentRequest" name="Create treatment request" />
    <bpmn:task id="Task_DictateLetter" name="Dictate clinic letter" />
    <bpmn:task id="Task_ApproveLetter" name="Approve clinic letter" />
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Letter approved?" />
    <bpmn:task id="Task_RequestMoreInfo" name="Request further information via Secretary" />
    <bpmn:task id="Task_RecordDNA" name="Record non-attendance (DNA)" />
    <bpmn:task id="Task_RecordDecline" name="Record outcome; arrange follow-up letter" />
    <bpmn:task id="Task_RequestSlot" name="Request appointment slot" />
    <bpmn:exclusiveGateway id="Gateway_SlotAvailable" name="Slot available?" />
    <bpmn:task id="Task_BookAppointment" name="Book appointment; letter to patient (phone if urgent)" />
    <bpmn:task id="Task_MarkPending" name="Mark pending; retry later" />
    <bpmn:task id="Task_BookTreatment" name="Book treatment cycle; confirm to patient" />
    <bpmn:task id="Task_AddToWaitingList" name="Add to waiting list; book later" />
    <bpmn:task id="Task_CheckFunding" name="Check funding / process payment" />
    <bpmn:exclusiveGateway id="Gateway_Funding" name="Funding outcome?" />
    <bpmn:task id="Task_InformFundingRefused" name="Inform patient and Consultant; discuss options" />
    <bpmn:endEvent id="EndEvent_FundingRefused" name="Treatment not funded" />
    <bpmn:task id="Task_ContactPatientRetry" name="Contact patient; retry payment" />
    <bpmn:boundaryEvent id="Boundary_Timer7Days" name="Letter overdue (7 days)" cancelActivity="false" attachedToRef="Task_SendLetter">
      <bpmn:timerEventDefinition id="TED_Boundary_Timer7Days">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_ReferralReceived" targetRef="Task_CheckReferral" />
    <bpmn:sequenceFlow id="Flow_05" name="GP resends; re-check" sourceRef="Task_RequestMissingInfo" targetRef="Task_CheckReferral" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_CheckReferral" targetRef="Gateway_Completeness" />
    <bpmn:sequenceFlow id="Flow_03" name="Complete" sourceRef="Gateway_Completeness" targetRef="Task_RegisterReferral" />
    <bpmn:sequenceFlow id="Flow_04" name="Incomplete" sourceRef="Gateway_Completeness" targetRef="Task_RequestMissingInfo" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_RegisterReferral" targetRef="Task_ReviewReferral" />
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_DictateLetter" targetRef="Task_PrepareLetter" />
    <bpmn:sequenceFlow id="Flow_40" name="Changes needed" sourceRef="Gateway_Approved" targetRef="Task_PrepareLetter" />
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_PrepareLetter" targetRef="Task_ApproveLetter" />
    <bpmn:sequenceFlow id="Flow_39" name="Approved" sourceRef="Gateway_Approved" targetRef="Task_SendLetter" />
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Task_SendLetter" targetRef="EndEvent_Complete" />
    <bpmn:sequenceFlow id="Flow_09" name="Reject" sourceRef="Gateway_ClinicalDecision" targetRef="Task_NotifyRejection" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_NotifyRejection" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_13" name="Redirect to correct service" sourceRef="Gateway_ClinicalDecision" targetRef="Task_NotifyRedirect" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_NotifyRedirect" targetRef="EndEvent_Redirected" />
    <bpmn:sequenceFlow id="Flow_42" sourceRef="Boundary_Timer7Days" targetRef="Task_EscalateOverdue" />
    <bpmn:sequenceFlow id="Flow_43" sourceRef="Task_EscalateOverdue" targetRef="EndEvent_Escalated" />
    <bpmn:sequenceFlow id="Flow_12" name="Information received" sourceRef="Task_RequestMoreInfo" targetRef="Task_ReviewReferral" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ReviewReferral" targetRef="Gateway_ClinicalDecision" />
    <bpmn:sequenceFlow id="Flow_08" name="Accept" sourceRef="Gateway_ClinicalDecision" targetRef="Task_RequestSlot" />
    <bpmn:sequenceFlow id="Flow_11" name="More information needed" sourceRef="Gateway_ClinicalDecision" targetRef="Task_RequestMoreInfo" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_BookAppointment" targetRef="Task_ConductConsultation" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_ConductConsultation" targetRef="Gateway_Consent" />
    <bpmn:sequenceFlow id="Flow_21" name="Patient consents" sourceRef="Gateway_Consent" targetRef="Task_CreateTreatmentRequest" />
    <bpmn:sequenceFlow id="Flow_22" name="Patient declines" sourceRef="Gateway_Consent" targetRef="Task_RecordDecline" />
    <bpmn:sequenceFlow id="Flow_23" name="Did not attend (DNA)" sourceRef="Gateway_Consent" targetRef="Task_RecordDNA" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_CreateTreatmentRequest" targetRef="Task_CheckFunding" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_RecordDecline" targetRef="Task_DictateLetter" />
    <bpmn:sequenceFlow id="Flow_35" name="Treatment delivered" sourceRef="Task_BookTreatment" targetRef="Task_DictateLetter" />
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_ApproveLetter" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_24" name="Rebook appointment" sourceRef="Task_RecordDNA" targetRef="Task_RequestSlot" />
    <bpmn:sequenceFlow id="Flow_18" name="Retry" sourceRef="Task_MarkPending" targetRef="Task_RequestSlot" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_RequestSlot" targetRef="Gateway_SlotAvailable" />
    <bpmn:sequenceFlow id="Flow_16" name="Slot available" sourceRef="Gateway_SlotAvailable" targetRef="Task_BookAppointment" />
    <bpmn:sequenceFlow id="Flow_17" name="No slot / service down" sourceRef="Gateway_SlotAvailable" targetRef="Task_MarkPending" />
    <bpmn:sequenceFlow id="Flow_28" name="Payment approved" sourceRef="Gateway_Funding" targetRef="Task_BookTreatment" />
    <bpmn:sequenceFlow id="Flow_34" name="When available" sourceRef="Task_AddToWaitingList" targetRef="Task_BookTreatment" />
    <bpmn:sequenceFlow id="Flow_33" name="Booking service busy" sourceRef="Gateway_Funding" targetRef="Task_AddToWaitingList" />
    <bpmn:sequenceFlow id="Flow_30" name="Retry payment" sourceRef="Task_ContactPatientRetry" targetRef="Task_CheckFunding" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_CheckFunding" targetRef="Gateway_Funding" />
    <bpmn:sequenceFlow id="Flow_29" name="Payment failed" sourceRef="Gateway_Funding" targetRef="Task_ContactPatientRetry" />
    <bpmn:sequenceFlow id="Flow_31" name="Funding refused" sourceRef="Gateway_Funding" targetRef="Task_InformFundingRefused" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_InformFundingRefused" targetRef="EndEvent_FundingRefused" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
