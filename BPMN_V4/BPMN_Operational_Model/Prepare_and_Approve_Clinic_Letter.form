      "key": "clinicLetterContent",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Clinic letter is approved",
      "type": "checkbox",
      "id": "approved",
      "key": "clinicLetterApproved",
      "validate": {
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "Prepare_and_Approve_Clinic_Letter",
